{
  "name": "boss-office-shell",
  "productName": "The Boss's Office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "package:win-portable": "npm run build && node scripts/package-win-portable.cjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "typescript": "^5.8.0",
    "wait-on": "^8.0.0"
  }
}
